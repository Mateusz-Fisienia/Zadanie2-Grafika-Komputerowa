import cv2
from matplotlib import pyplot as plt
import numpy as np
import urllib.request

# ==========================================
# 1. Wczytanie zdalnego zdjęcia z Wikimedia Commons
# ==========================================
image_url = (
    "https://upload.wikimedia.org/wikipedia/commons/thumb/e/e4/Lemon.jpg/800px-Lemon.jpg"
)

# Pobranie obrazu przez sieć
req = urllib.request.urlopen(image_url)
arr = np.asarray(bytearray(req.read()), dtype=np.uint8)
image_original = cv2.imdecode(arr, cv2.IMREAD_COLOR)

# Konwersja BGR -> RGB do poprawnego wyświetlenia w Matplotlib
image_rgb = cv2.cvtColor(image_original, cv2.COLOR_BGR2RGB)

# Wyświetlenie oryginalnego obrazu
plt.figure(figsize=(5, 5))
plt.imshow(image_rgb)
plt.title("1. Oryginalne zdjęcie")
plt.axis("off")
plt.show()


# ==========================================
# 2. Wyświetlenie histogramu dla całego zdjęcia i kanałów RGB
# ==========================================
plt.figure(figsize=(10, 4))

# A. Histogram dla całego zdjęcia (konwersja do odcieni szarości)
gray_image = cv2.cvtColor(image_original, cv2.COLOR_BGR2GRAY)
plt.subplot(1, 2, 1)
plt.hist(gray_image.ravel(), 256, [0, 256], color="black")
plt.title("Histogram - Całe zdjęcie (Gray)")
plt.xlabel("Wartość piksela (0-255)")
plt.ylabel("Liczba pikseli")

# B. Histogram dla poszczególnych kanałów (R, G, B)
plt.subplot(1, 2, 2)
colors = ("b", "g", "r")  # Kolejność w OpenCV to BGR
for i, col in enumerate(colors):
  hist = cv2.calcHist([image_original], [i], None, [256], [0, 256])
  plt.plot(hist, color=col, label=f"Kanał {col.upper()}")
plt.title("Histogram - Kanały RGB")
plt.xlabel("Wartość piksela (0-255)")
plt.ylabel("Liczba pikseli")
plt.legend()

plt.tight_layout()
plt.show()


# ==========================================
# 3. Algorytm szacujący jakość zdjęcia na podstawie histogramu
# ==========================================
def assess_image_quality(image):
  gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
  hist = cv2.calcHist([gray], [0], None, [256], [0, 256])
  total_pixels = gray.size

  # Kryteria jakości na podstawie rozkładu pikseli:
  # - Niedoświetlenie: dużo pikseli w ciemnych partiach (0-20)
  # - Prześwietlenie: dużo pikseli w jasnych partiach (235-255)
  # - Niski kontrast: piksele skupione w wąskim zakresie (brak rozpiętości)

  dark_pixels_pct = (
      np.sum(hist[0:21]) / total_pixels
  ) * 100  # piksele 0-20
  bright_pixels_pct = (
      np.sum(hist[235:256]) / total_pixels
  ) * 100  # piksele 235-255

  # Sprawdzenie rozpiętości histogramu (kontrast)
  non_zero_indices = np.where(hist > 0)[0]
  dynamic_range = (
      non_zero_indices[-1] - non_zero_indices[0] if len(non_zero_indices) > 0 else 0
  )

  print("--- WYNIKI ANALIZY JAKOŚCI ---")
  print(f"Piksele niedoświetlone (ciemne): {dark_pixels_pct:.2f}%")
  print(f"Piksele prześwietlone (jasne): {bright_pixels_pct:.2f}%")
  print(f"Rozpiętość tonalna (kontrast): {dynamic_range} / 255")

  quality_status = "Prawidłowa"
  reasons = []

  if dark_pixels_pct > 40:
    quality_status = "Wadliwe (Niedoświetlone)"
    reasons.append("zbyt dużo ciemnych pikseli")
  elif bright_pixels_pct > 40:
    quality_status = "Wadliwe (Prześwietlone)"
    reasons.append("zbyt dużo jasnych pikseli")
  elif dynamic_range < 120:
    quality_status = "Wadliwe (Niski kontrast)"
    reasons.append("zbyt wąska rozpiętość tonalna histogramu")

  print(f"Ocena końcowa: {quality_status}")
  return quality_status, gray


status, _ = assess_image_quality(image_original)


# ==========================================
# BONUS: Algorytm poprawiający jakość zdjęcia (korekcja kontrastu / CLAHE)
# ==========================================
if "Wadliwe" in status:
  print(
      "\n[BONUS] Wykryto wadliwe zdjęcie. Uruchamiam algorytm poprawy jakości"
      " (CLAHE)..."
  )

  # Rozdzielamy kanały, stosujemy algorytm adaptacyjnego wyrównania histogramu (CLAHE) dla każdego kanału
  lab = cv2.cvtColor(image_original, cv2.COLOR_BGR2LAB)
  l, a, b = cv2.split(lab)

  clahe = cv2.createCLAHE(clipLimit=3.0, tileGridSize=(8, 8))
  l_cl = clahe.apply(l)

  limg = cv2.merge((l_cl, a, b))
  improved_image = cv2.cvtColor(limg, cv2.COLOR_LAB2BGR)
  improved_rgb = cv2.cvtColor(improved_image, cv2.COLOR_BGR2RGB)

  # Wyświetlenie poprawionego obrazu
  plt.figure(figsize=(5, 5))
  plt.imshow(improved_rgb)
  plt.title("Zdjęcie poprawione (Algorytm CLAHE)")
  plt.axis("off")
  plt.show()

  # Ponowna ocena jakości po poprawie
  print("Ponowna ocena jakości po korekcji:")
  assess_image_quality(improved_image)
else:
  print(
      "\n[BONUS] Zdjęcie zostało ocenione jako prawidłowe, więc algorytm"
      " korekcyjny nie musiał być uruchamiany."
  )















import urllib.request
import numpy as np
import cv2
from matplotlib import pyplot as plt

# Używamy bezpośredniego linku do oryginalnego obrazu, aby uniknąć błędu 400 związanego z rozmiarem miniatury
url = "https://upload.wikimedia.org/wikipedia/commons/e/e4/Lemon.jpg"
# Dodanie nagłówka User-Agent, aby uniknąć błędu 403 Forbidden
req_headers = {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)"}
req = urllib.request.Request(url, headers=req_headers)

with urllib.request.urlopen(req) as response:
    arr = np.asarray(bytearray(response.read()), dtype=np.uint8)
img = cv2.imdecode(arr, cv2.IMREAD_COLOR)

plt.figure(figsize=(5, 5))
plt.imshow(cv2.cvtColor(img, cv2.COLOR_BGR2RGB))
plt.axis("off")
plt.show()

gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
plt.figure(figsize=(10, 4))
plt.subplot(1, 2, 1)
plt.hist(gray.ravel(), 256, [0, 256], color="black")

plt.subplot(1, 2, 2)
for i, col in enumerate(["b", "g", "r"]):
  hist = cv2.calcHist([img], [i], None, [256], [0, 256])
  plt.plot(hist, color=col)
plt.show()


def assess_quality(image):
  g = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
  h = cv2.calcHist([g], [0], None, [256], [0, 256])
  total = g.size
  dark = (np.sum(h[0:21]) / total) * 100
  bright = (np.sum(h[235:256]) / total) * 100
  nz = np.where(h > 0)[0]
  rng = nz[-1] - nz[0] if len(nz) > 0 else 0

  status = "Prawidłowa"
  if dark > 40:
    status = "Wadliwe (Niedoœwietlone)"
  elif bright > 40:
    status = "Wadliwe (Przeœwietlone)"
  elif rng < 120:
    status = "Wadliwe (Niski kontrast)"

  print("Ocena:", status)


assess_quality(img)
